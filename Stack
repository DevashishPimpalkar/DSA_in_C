#include <stdio.h>
#define SIZE 5

int stack[SIZE];
int top = -1;

void push(int value) {
    if (top == SIZE - 1) {
        printf("Stack is full");
    }
    else {
        stack[++top] = value;
    }
}

void pop() {
    if (top == - 1) {
        printf("Stack is empty or underflow");
    }
    else {
        stack[top--];
    }
}

void peek() {
    if (top == - 1) {
        printf("Stack is empty or underflow");
    }
    else {
        printf("Top: %d\n", stack[top]);
    }
}

int isEmpty() {
    return top == -1;
}

int isFull() {
    return top == SIZE - 1;
}

int main() {
    push(10);
    push(20);
    pop();
    peek();

    return 0;
}
